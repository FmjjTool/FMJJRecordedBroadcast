<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cn.fmjj</groupId>
  <artifactId>fengming-toolbox-java</artifactId>
  <version>2.9.1</version>
  <packaging>jar</packaging>

  <name>FengMingToolbox Java</name>
  <description>封茗囧菌数据汇总库 · 统一维护工具箱 Java 全栈版（PySide6 版的 Java 移植）</description>

  <properties>
    <!-- 需 JDK 27+：JDK 27 移除了 jdk.jsobject，JavaFX 21 的 WebView 无法运行；
         JavaFX 27 与之配套，且 FFM 已是正式 API（FernetCompat 读注册表用） -->
    <maven.compiler.release>27</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>27.0.1</javafx.version>
    <jackson.version>2.17.2</jackson.version>
    <junit.version>5.11.3</junit.version>
    <mainClass>cn.fmjj.toolbox.ToolboxApp</mainClass>
  </properties>

  <dependencies>
    <!-- JavaFX 21（Windows 原生库分类器；跨平台构建时改为对应平台） -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>win</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>win</classifier>
    </dependency>
    <!-- 注意：不引入 javafx-web —— JDK 27 已移除 jdk.jsobject，WebView 无法启动。
         浏览器登录改为「系统浏览器 + 粘贴 Cookie」，自动捕获在 M5 用 playwright-java 落地。 -->

    <!-- 二维码生成（B站扫码登录） -->
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>3.5.3</version>
    </dependency>

    <!-- JSON（BCC 字幕 / 配置读写 / 平台 API 解析） -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- HTML 解析（公众号文章等页面解析，对应 Python 版 BeautifulSoup） -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.18.1</version>
    </dependency>

    <!-- 音乐标签读写（对应 Python 版 mutagen） -->
    <dependency>
      <groupId>net.jthink</groupId>
      <artifactId>jaudiotagger</artifactId>
      <version>3.0.1</version>
    </dependency>

    <!-- 已获取数据持久化（config/collected.db） -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.46.1.0</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <systemPropertyVariables>
            <!-- 测试隔离：绝不碰真实 config/（否则 CookieStoreTest 会删掉用户 cookies.json） -->
            <fmjj.home>${project.build.directory}/test-home</fmjj.home>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- mvn javafx:run 可直接启动（自动拼 module-path） -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${mainClass}</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>cn.fmjj.toolbox.Launcher</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- 复制全部依赖到 target/lib（供 jpackage app-image 的 input 目录使用） -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
              <overWriteReleases>false</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
